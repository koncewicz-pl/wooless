{
	{$CADDY_GLOBAL_OPTIONS}

	skip_install_trust

	admin {$CADDY_SERVER_ADMIN_HOST}:{$CADDY_SERVER_ADMIN_PORT}

	frankenphp {
		worker {
			file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
			{$CADDY_SERVER_WORKER_DIRECTIVE}
			{$CADDY_SERVER_WATCH_DIRECTIVES}
		}
	}
}

{$CADDY_EXTRA_CONFIG}

# Extra domains (www and any other alias) redirect to the main one. Both variables
# come from config/octane.php (caddy.env), built from OCTANE_HOST and
# OCTANE_REDIRECT_HOSTS in .env; by default only www.<domain> is redirected.
# Caddy obtains the certificates itself: Let's Encrypt in production, the
# internal CA for *.localhost (no ACME attempts locally).
{$CADDY_REDIRECT_HOSTS} {
	redir https://{$CADDY_APP_HOST}{uri} permanent
}

{$CADDY_SERVER_SERVER_NAME} {
	log {
		level {$CADDY_SERVER_LOG_LEVEL}

		# Redact the authorization query parameter that can be set by Mercure...
		format filter {
			wrap {$CADDY_SERVER_LOGGER}
			fields {
				request>uri query {
					replace authorization REDACTED
				}
			}
		}
	}

	# Compressing the Mercure stream costs memory per subscriber and enables BREACH-style attacks...
	@compressible not path /.well-known/mercure

	route {
		root * "{$APP_PUBLIC_PATH}"
		encode @compressible zstd br gzip

		@redirect_checkout path_regexp checkout /wordpress/checkout/order-received/(\d+)
		handle @redirect_checkout {
			redir * /checkout/order/{re.checkout.1}?{query}
		}

		# WordPress proxy
		@allow {
			path /wordpress/wc-auth/*
			path /wordpress/wp-json/*
			path /wordpress/wc-api/przelewy24/*
			path /wordpress/wp/wp-includes/*
			path /wordpress/wp/wp-admin/*
			path /wordpress/wp/wp-login.php
			path /wordpress/wp/wp-cron.php
			path /wordpress/app/*
		}

		@deny {
			path /wordpress/*
		}

		reverse_proxy @allow {$WORDPRESS_CONTAINER_URL} {
			transport http {
				tls_insecure_skip_verify
			}

			header_up Host wooless-wordpress-app
			header_up X-Forwarded-Host {$WORDPRESS_HOST}
			header_up X-Forwarded-Proto https

			@hide_error_page status 403 404 500 502 503
			handle_response @hide_error_page {
				respond 404 {
					body "Not Found"
				}
			}
		}

		respond @deny 404 {
			body "Not Found"
		}

		# Mercure configuration is injected here...
		{$CADDY_SERVER_EXTRA_DIRECTIVES}

		php_server {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			# Required for the public/storage/ directory...
			resolve_root_symlink
		}
	}
}
